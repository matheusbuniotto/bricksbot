#             # Replace with a small notebook/python that curls:
#             # POST ${var.app_url}/api/webhooks/routines/${var.routine_id}
#             # Header: X-BricksBot-Webhook-Key: <secret from Databricks secret>
#             python_file: ./scripts/ping_routine_webhook.py
