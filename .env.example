DATABRICKS_CONFIG_PROFILE=dev
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=bricksbot
FLASK_RUN_HOST=localhost

# Lakebase local dev (after deploy-first so the App SP owns schema bricksbot).
# Branch: projects/clawhouse/branches/bricksbot
# PGHOST=ep-odd-bread-d8804d0r.database.us-east-2.cloud.databricks.com
# PGPORT=5432
# PGDATABASE=databricks_postgres
# PGSSLMODE=require
# LAKEBASE_ENDPOINT=projects/clawhouse/branches/bricksbot/endpoints/primary

# ChatClient — OpenAI-compatible primary (same OpenRouter secret as clawhouse)
# OPENROUTER_API_KEY=
# Optional overrides (defaults match clawhouse: OpenRouter + openai/gpt-6-luna):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-6-luna

# ChatClient — Databricks Model Serving option
# LLM_PROVIDER=databricks
# DATABRICKS_HOST=https://dbc-562d9321-2592.cloud.databricks.com
# DATABRICKS_SERVING_ENDPOINT_NAME=
# DATABRICKS_TOKEN=
# SQL warehouse for sql_query. Host and token above are reused. No warehouse resource is bound in the bundle yet.
# DATABRICKS_WAREHOUSE_ID=

# Allowlisted hosts for web_fetch (comma-separated). Empty disables the tool.
# WEB_FETCH_ALLOWLIST=docs.databricks.com,example.com

# Phase 5 sandbox. Deployed app.yaml uses databricks (falls back to python_exec if
# Sandboxes Public Beta preview is off). Locally also needs DATABRICKS_HOST + token/M2M.
# SANDBOX_BACKEND=off
SANDBOX_BACKEND=databricks
# SANDBOX_BACKEND=python_exec
# SANDBOX_BACKEND=e2b
# DATABRICKS_HOST=https://dbc-562d9321-2592.cloud.databricks.com
# DATABRICKS_TOKEN=
# SANDBOX_IDLE_MINUTES=15
# SANDBOX_EXEC_TIMEOUT_SEC=120
# SANDBOX_MAX_SESSION_MINUTES=120
# SANDBOX_MAX_ACTIVE_PER_USER=3
# SANDBOX_ARTIFACT_VOLUME_PATH=/Volumes/main/default/bricksbot_artifacts
# E2B_API_KEY=
# E2B_DOMAIN=
# E2B_TEMPLATE_ID=

# Optional public App URL for install/setup status (not auto-discovered from Databricks)
# BRICKSBOT_PUBLIC_APP_URL=https://bricksbot-1234567890123456.us-west-2.databricksapps.com
