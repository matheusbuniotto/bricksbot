DATABRICKS_CONFIG_PROFILE=dev
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=bricksbot
FLASK_RUN_HOST=localhost

# Lakebase local dev — fill only after a project is bound. See resources/lakebase.postgres.yml.stub.
# PGHOST=
# PGPORT=5432
# PGDATABASE=
# PGSSLMODE=require
# LAKEBASE_ENDPOINT=projects/<project-id>/branches/<branch-id>/endpoints/<endpoint-id>

# OpenAI-compatible LLM (primary). Secrets stay here or in a Databricks secret scope — never in the client bundle.
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
