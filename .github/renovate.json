{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", ":semanticCommits"],
  "schedule": ["before 6am on monday"],
  "timezone": "America/Sao_Paulo",
  "labels": ["dependencies"],
  "packageRules": [
    { "groupName": "appkit", "matchPackageNames": ["@databricks/appkit", "@databricks/appkit-ui"] },
    {
      "groupName": "eslint",
      "matchPackageNames": [
        "eslint",
        "@eslint/**",
        "typescript-eslint",
        "@typescript-eslint/**",
        "eslint-plugin-**",
        "eslint-config-**"
      ]
    },
    { "groupName": "github actions", "matchManagers": ["github-actions"] },
    { "matchDepTypes": ["devDependencies"], "matchUpdateTypes": ["patch"], "automerge": true }
  ]
}
