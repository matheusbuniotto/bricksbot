# Copy to `dev.local.yml` (gitignored). The bundle already includes `*.local.yml`.
# Fill these from your own workspace — never commit real ids or hosts.

targets:
  dev:
    # Optional: override host if the profile's default host is wrong.
    # workspace:
    #   host: https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
    variables:
      # Required for App postgres + sql tools. See README → Deploy to a workspace.
      lakebase_branch: projects/<your-project>/branches/<your-branch>
      lakebase_database: projects/<your-project>/branches/<your-branch>/databases/databricks-postgres
      sql_warehouse_id: "<your-warehouse-id>"

      # Model Serving instead of OpenRouter: the chat endpoint to call, and the llm:serving blocks
      # enabled in databricks.yml and app.yaml (`npm run bootstrap` does both).
      # serving_endpoint_name: databricks-gpt-oss-120b

      # Optional: OpenRouter secret scope/key (defaults are bricksbot / openrouter-api-key)
      # provider_secret_scope: bricksbot
      # provider_secret_key: openrouter-api-key
      # app_secret_scope: bricksbot

      # Optional: scheduled Job → routine webhook (after you create a routine)
      # routine_webhook_app_base_url: https://bricksbot-….databricksapps.com
      # routine_webhook_routine_id: "<routine-uuid>"
      # routine_webhook_pause_status: UNPAUSED

  # Optional: a second install in the same workspace (own app name and deploy state).
  # Deploy with `databricks bundle deploy -t smoke -p <profile>`.
  # smoke:
  #   mode: development
  #   variables:
  #     app_name: bricksbot-smoke
  #     lakebase_branch: projects/<other-project>/branches/production
  #     lakebase_database: projects/<other-project>/branches/production/databases/databricks-postgres
  #     sql_warehouse_id: "<your-warehouse-id>"
